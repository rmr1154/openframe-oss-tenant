# OpenFrame Azure - Development Environment Configuration
# Balanced configuration for active development

# Azure Settings
AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=openframe-dev

# AKS Configuration
AKS_NODE_COUNT=2
AKS_NODE_SIZE=Standard_B4ms
AKS_MIN_NODES=2
AKS_MAX_NODES=4
AKS_ENABLE_AUTOSCALER=true

# Cosmos DB (MongoDB API)
COSMOS_DB_MODE=Provisioned
COSMOS_DB_RU=1000
COSMOS_DB_CONSISTENCY=Session

# Azure Cache for Redis
REDIS_SKU=Standard
REDIS_SIZE=C1

# Event Hubs (Kafka replacement)
EVENTHUBS_TIER=Standard
EVENTHUBS_CAPACITY=1
EVENTHUBS_PARTITIONS=4

# Container Registry
ACR_SKU=Standard

# Storage
STORAGE_REDUNDANCY=LRS

# Monitoring
ENABLE_AZURE_MONITOR=true
ENABLE_GRAFANA=true

# High Availability
ENABLE_ZONE_REDUNDANCY=false
ENABLE_MULTI_REPLICA=false

# Application Settings
SPRING_PROFILES_ACTIVE=azure,dev
LOG_LEVEL=INFO
REPLICAS_API=1
REPLICAS_GATEWAY=1
REPLICAS_STREAM=1

# Estimated Monthly Cost: $350-500
