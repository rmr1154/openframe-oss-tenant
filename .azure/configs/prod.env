# OpenFrame Azure - Production Environment Configuration
# Full-featured configuration with high availability

# Azure Settings
AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=openframe-prod

# AKS Configuration
AKS_NODE_COUNT=3
AKS_NODE_SIZE=Standard_D4s_v5
AKS_MIN_NODES=3
AKS_MAX_NODES=10
AKS_ENABLE_AUTOSCALER=true
AKS_AVAILABILITY_ZONES=1,2,3

# Cosmos DB (MongoDB API)
COSMOS_DB_MODE=Autoscale
COSMOS_DB_RU=4000
COSMOS_DB_MAX_RU=10000
COSMOS_DB_CONSISTENCY=Session
COSMOS_DB_MULTI_REGION=false

# Azure Cache for Redis
REDIS_SKU=Premium
REDIS_SIZE=P1
REDIS_REPLICAS=1

# Event Hubs (Kafka replacement)
EVENTHUBS_TIER=Standard
EVENTHUBS_CAPACITY=2
EVENTHUBS_PARTITIONS=8
EVENTHUBS_RETENTION_DAYS=7

# Container Registry
ACR_SKU=Standard
ACR_GEO_REPLICATION=false

# Storage
STORAGE_REDUNDANCY=ZRS

# Monitoring
ENABLE_AZURE_MONITOR=true
ENABLE_GRAFANA=true
ENABLE_LOG_ANALYTICS=true
RETENTION_DAYS=30

# High Availability
ENABLE_ZONE_REDUNDANCY=true
ENABLE_MULTI_REPLICA=true

# Application Settings
SPRING_PROFILES_ACTIVE=azure,prod
LOG_LEVEL=WARN
REPLICAS_API=2
REPLICAS_GATEWAY=2
REPLICAS_STREAM=2

# Security
ENABLE_PRIVATE_ENDPOINTS=true
ENABLE_NETWORK_POLICY=true
ENABLE_POD_SECURITY=true

# Estimated Monthly Cost: $1,500-3,000
