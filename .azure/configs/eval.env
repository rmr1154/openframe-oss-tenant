# OpenFrame Azure - Evaluation Environment Configuration
# Absolute minimal cost for evaluation/demos
# ALL services self-hosted on AKS - no Azure managed databases

# Azure Settings
AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=openframe-eval

# AKS Configuration - Single node, burstable VM
AKS_NODE_COUNT=1
AKS_NODE_SIZE=Standard_B4ms
AKS_MIN_NODES=1
AKS_MAX_NODES=1
AKS_ENABLE_AUTOSCALER=false

# SKIP Azure Managed Data Services - use self-hosted on AKS
USE_COSMOS_DB=false
USE_AZURE_REDIS=false
USE_EVENT_HUBS=false

# Use self-hosted components from manifests instead:
# - MongoDB (from manifests/datasources/mongodb)
# - Redis (from manifests/datasources/redis)
# - Kafka (from manifests/datasources/kafka)
# - Cassandra (from manifests/datasources/cassandra)
# - Pinot (from manifests/datasources/pinot)

# Container Registry - Basic tier
ACR_SKU=Basic

# Storage - minimal
STORAGE_REDUNDANCY=LRS

# Monitoring - DISABLED to save costs
ENABLE_AZURE_MONITOR=false
ENABLE_LOG_ANALYTICS=false

# High Availability - DISABLED
ENABLE_ZONE_REDUNDANCY=false

# Application Settings - minimal resources
SPRING_PROFILES_ACTIVE=dev
REPLICAS_API=1
REPLICAS_GATEWAY=1
REPLICAS_STREAM=1

# Estimated Monthly Cost: $100-130
# - AKS (1x B4ms): ~$85
# - ACR Basic: ~$5
# - Load Balancer: ~$18
# - Storage: ~$1
# - Bandwidth: ~$1
