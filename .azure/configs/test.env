# OpenFrame Azure - Test Environment Configuration
# Minimal cost configuration for testing and evaluation

# Azure Settings
AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=openframe-test

# AKS Configuration
AKS_NODE_COUNT=1
AKS_NODE_SIZE=Standard_B4ms
AKS_MIN_NODES=1
AKS_MAX_NODES=2
AKS_ENABLE_AUTOSCALER=true

# Cosmos DB (MongoDB API)
COSMOS_DB_MODE=Serverless
COSMOS_DB_RU=0
COSMOS_DB_CONSISTENCY=Session

# Azure Cache for Redis
REDIS_SKU=Basic
REDIS_SIZE=C0

# Event Hubs (Kafka replacement)
EVENTHUBS_TIER=Basic
EVENTHUBS_CAPACITY=1
EVENTHUBS_PARTITIONS=2

# Container Registry
ACR_SKU=Basic

# Storage
STORAGE_REDUNDANCY=LRS

# Monitoring
ENABLE_AZURE_MONITOR=false
ENABLE_GRAFANA=false

# High Availability
ENABLE_ZONE_REDUNDANCY=false
ENABLE_MULTI_REPLICA=false

# Application Settings
SPRING_PROFILES_ACTIVE=azure,test
LOG_LEVEL=DEBUG
REPLICAS_API=1
REPLICAS_GATEWAY=1
REPLICAS_STREAM=1

# Estimated Monthly Cost: $150-250
